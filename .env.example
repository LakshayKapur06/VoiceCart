# Explicit local owner database; create it yourself. No products are seeded.
VOICECART_DATABASE_URL='postgresql://localhost/voicecart'
VOICECART_OLLAMA_URL='http://127.0.0.1:11434'
VOICECART_INFERENCE_TIMEOUT=120
